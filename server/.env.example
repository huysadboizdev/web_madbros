PORT=80
NODE_ENV=production
DATABASE_URL="file:./dev.db"
JWT_SECRET="madbros-enterprise-secret-key-2026-super-secure"

# ===================================================
# 🔑 CẤU HÌNH TÀI KHOẢN ADMIN (TỰ ĐỘNG KHỞI TẠO KHI CHẠY SERVER)
# ===================================================
ADMIN_EMAIL=admin@madbros.vn
ADMIN_PASSWORD=123456
ADMIN_NAME="Quản Trị Viên"
WORKSPACE_NAME="Công Ty Công Nghệ MadBros"
WORKSPACE_CODE=MADBROS

# ===================================================
# 📧 CẤU HÌNH GỬI MAIL (SMTP GMAIL / SERVER RIÊNG)
# ===================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hệ Thống MadBros <no-reply@madbros.vn>"

# ===================================================
# 🤖 CẤU HÌNH BOT TELEGRAM THÔNG BÁO TỰ ĐỘNG
# ===================================================
# Token bot lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=
# Chat ID của Nhóm Telegram (VD: -1001234567890 hoặc nhiều ID cách nhau bằng dấu phẩy)
TELEGRAM_CHAT_ID=
# Chat ID của Kênh Telegram Broadcast (VD: -1009876543210 hoặc @tenkenh)
TELEGRAM_CHANNEL_ID=
# Bật/Tắt tính năng thông báo Telegram (true / false)
TELEGRAM_ENABLED=true
